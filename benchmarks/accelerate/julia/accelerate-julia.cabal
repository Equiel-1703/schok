cabal-version:      2.4
name:               accelerate-julia
version:            0.1.0.0
build-type:         Simple
synopsis:           Accelerate re-implementation of the CUDA julia.cu benchmark

executable accelerate-julia
  main-is:            Main.hs
  hs-source-dirs:     app
  default-language:   Haskell2010
  ghc-options:        -O2 -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:      base       >=4.14 && <5
                     , accelerate
                     , accelerate-llvm-ptx
                     , time
                     , deepseq
