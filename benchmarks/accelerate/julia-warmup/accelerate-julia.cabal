cabal-version:      2.4
name:               accelerate-julia
version:            0.2.0.0
build-type:         Simple
synopsis:           Accelerate Julia-set benchmark: cold (single run) and warm (runN) variants

common shared
  default-language:   Haskell2010
  ghc-options:        -O2 -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:      base >=4.14 && <5
                    , accelerate
                    , accelerate-llvm-ptx
                    , deepseq
                    , time

-- No warm-up: JIT compilation + CUDA context creation are inside the timed region.
executable accelerate-julia-cold
  import:             shared
  main-is:            Cold.hs
  hs-source-dirs:     app

-- runN warm-up on a tiny input first; timed run excludes JIT compilation.
executable accelerate-julia-warm
  import:             shared
  main-is:            Warm.hs
  hs-source-dirs:     app
