cabal-version:      2.4
name:               nn-accelerate
version:            0.1.0.0
build-type:         Simple

executable nn-accelerate
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  ghc-options:         -O2 -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:       base            >=4 && <5
                      , accelerate
                      , accelerate-llvm-ptx
                      , random
                      , time
                      , deepseq
